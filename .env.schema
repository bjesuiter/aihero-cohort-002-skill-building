# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$DEV_ENV
# ---

# Local development profile selector. Normal scripts set DEV_ENV inline;
# resolver refs live in committed .env.<profile> files.
# @type=enum(development, jb, test, production)
DEV_ENV=development

# Google Gemini API key used by course exercises that default to Google models.
# @auditIgnore=true
# @sensitive @type=string
GOOGLE_GENERATIVE_AI_API_KEY=

# Anthropic API key for exercises adapted to Claude models.
# @auditIgnore=true
# @sensitive @type=string
ANTHROPIC_API_KEY=

# OpenAI API key for exercises adapted to OpenAI models.
# @auditIgnore=true
# @sensitive @type=string
OPENAI_API_KEY=

# OpenCode Zen API key used by local @local/utils Zen provider helpers.
# @sensitive @type=string
OPENCODE_ZEN_API_KEY=

# OpenCode Zen API endpoint used by local @local/utils Zen provider helpers.
# @type=url
OPENCODE_ZEN_API_ENDPOINT=
